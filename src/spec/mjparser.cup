package rs.ac.bg.etf.pp1;

import java_cup.runtime.*;

parser code {:
	
	
    
:}

scan with {:
	Symbol s = this.getScanner().next_token();
	if (s != null && s.value != null) 
		System.err.println(s.toString() + " " + s.value.toString());
	return s;
:}


terminal PROG, PRINT, ORD, CHR, LEN, RETURN, LENGTH;
terminal CONST, STATIC;
terminal ABST, CLASS, EXTEND, THIS, NEW;
terminal IF, ELSE, SWITCH, FOR, CONT, BREAK;
terminal VOID, ENUM;
terminal PLUS, MINUS, EQUAL, MUL, DIV, AND, OR, NOT, MOD;
terminal QUEST, SEMI, COLON, COMMA, DOT, SQUOT, LSTHAN, GRTHAN;
terminal LPAREN, RPAREN, LBRACE, RBRACE, LBRACK, RBRACK;
terminal String STRING;
terminal Integer NUMBER;
terminal String IDENT;

nonterminal Program;
nonterminal VarDecl, VarDeclVars, VarDeclVar;
nonterminal Type;

/*
Program ::= PROG IDENT (ConsDecl | VarDecl | ClassDecl | EnumDecl | AbstractClassDecl) LBRACE {MethodDecl} RBRACE ; 
*/

Program ::= VarDecl;

VarDecl ::= Type VarDeclVars SEMI;

VarDeclVars ::= VarDeclVar | VarDeclVars COMMA VarDeclVar;

VarDeclVar ::= IDENT | IDENT LBRACK RBRACK;

Type ::= IDENT;
